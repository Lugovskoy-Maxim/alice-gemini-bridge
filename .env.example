# Обязательный ключ из Google AI Studio
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Порт только на loopback VPS: Nginx будет проксировать webhook сюда
APP_PORT=8787

# Подсеть Compose. Не должна пересекаться с адресами вашего WireGuard-пира.
DOCKER_SUBNET=172.30.0.0/24
DOCKER_GATEWAY=172.30.0.1
